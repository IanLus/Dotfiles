#!/hint/zsh
# enable color support of ls and also add handy aliases
if [ -x /usr/bin/dircolors ]; then
    test -r $DOTDIR/dircolors && eval "$(dircolors -b $DOTDIR/dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias dir='dir --color=auto'
    alias vdir='vdir --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi
if command -v eza >/dev/null 2>&1; then
    alias ls='eza -g -F auto'
fi
alias sudo='sudo '
alias man='man '
alias wget='wget --hsts-file $XDG_CONFIG_HOME/.wget-hsts'
alias v='nvim'
alias l='ls -l'
alias ll='ls -l'
alias lls='ls -lahtr'
alias lla='ls -la'
alias la='ls -A'
alias cls='clear'
alias zshconfig='v $ZDOTDIR/.zshrc'
alias shutdown='sudo shutdown now'
alias restart='sudo reboot'
alias d='dirs -v'
alias gs='git status'
alias ga='git add'
alias gp='git push'
alias gpo='git push origin'
alias gtd='git tag --delete'
alias gtdr='git tag --delete origin'
alias gr='git branch -r'
alias gpl='git pull'
alias gplo='git pull origin'
alias gb='git branch '
alias gbvv='git branch -vv '
alias gc='git commit'
alias gd='git diff'
alias gco='git checkout '
alias gl='git log'
alias gr='git remote'
alias grs='git remote show'
alias grv='git remote -v'
alias glo='git log --pretty="oneline"'
alias glog='git log --graph --oneline --decorate'
alias gmv='git mv'
alias tc='tmux attach -t'
alias tkill='pkill -f tmux'
alias tl='tmux ls'
alias tn='tmux new -s'
alias treload='tmux source-file $XDG_CONFIG_HOME/dotfiles/tmux/tmux.conf'
# WSL 里 clip.exe 走互操作，脚本拦不住；交互中改走 $DOTDIR/bin/clip（win32yank）
alias clip.exe=clip
alias spr=proxy_on
alias cpr=proxy_off
alias gpr=proxy_status

function mkcd() {
    mkdir -p "$1" && cd "$1" || return $?
}
alias mvg='/usr/local/bin/advmv -g'
alias cpg='/usr/local/bin/advcp -g'
alias lg="lazygit"
## 用于从ranger退出时自动跳转到ranger所处位置
function ranger_cd {
    temp_file="$(mktemp)"
    ranger --choosedir="$temp_file" "$@"
    test -f "$temp_file" && [ "$(cat -- "$temp_file")" != "$(pwd)" ] && cd -- "$(cat -- "$temp_file")"
    rm -f -- "$temp_file"
}
alias ra='ranger_cd'
